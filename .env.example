# Copy to .env.local and fill in. Never commit real values.
# All of these are server-only. None may be prefixed NEXT_PUBLIC_.

# --- Supabase ---
# Project URL, e.g. https://<project-ref>.supabase.co
# (or http://127.0.0.1:54321 for the local `npx supabase start` stack)
SUPABASE_URL=
# Service role key. Bypasses RLS; used only in server code. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio ---
# Account SID (starts with AC)
TWILIO_ACCOUNT_SID=
# API key SID (starts with SK) and its secret. Used instead of the account auth token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Auth token. Needed only to validate X-Twilio-Signature on webhooks (Twilio signs with it).
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164, e.g. +18885550100
TWILIO_FROM_NUMBER=

# --- Messaging behavior ---
# Which provider to use: "mock" (default) or "twilio"
MESSAGING_PROVIDER=mock
# true (default): every outbound SMS goes to the Twilio Virtual Phone, not the contact.
# Forced on in Vercel preview deployments. Set to false only on purpose.
SANDBOX_MODE=true

# --- App ---
# Exact public base URL Twilio calls, no trailing slash. Used for webhook signature
# validation and status callback URLs. e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=http://localhost:3000